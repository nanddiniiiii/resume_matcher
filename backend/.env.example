# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/job_matcher

# Application Settings
APP_ENV=development
DEBUG=False
API_HOST=127.0.0.1
API_PORT=8000

# CORS Origins (JSON array)
CORS_ORIGINS=["http://localhost:3000"]

# Upload Settings
MAX_UPLOAD_SIZE=5242880  # 5MB in bytes
UPLOAD_DIR=./uploads

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
# Accounts allowed to create/update/delete jobs and run scraping
ADMIN_EMAILS=[]
